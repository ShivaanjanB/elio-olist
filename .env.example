# Copy to .env (git-ignored) and fill in.
# Windows:      . .\scripts\load_env.ps1
# macOS/Linux:  set -a; . ./.env; set +a

# <orgname>-<accountname>, from the Snowsight URL app.snowflake.com/<org>/<account>
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=ELIO_SVC
# Private key generated per ingest/README.md, stored OUTSIDE the repo
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/.snowflake/elio/rsa_key.p8
SNOWFLAKE_ROLE=ELIO_TRANSFORMER
SNOWFLAKE_WAREHOUSE=ELIO_WH
SNOWFLAKE_DATABASE=ELIO_OLIST
